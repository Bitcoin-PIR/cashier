[Unit]
Description=BitcoinPIR cashier (session grants for Cashu ecash)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bpir-cashier
Group=bpir-cashier
UMask=0077
StateDirectory=bitcoinpir-cashier
StateDirectoryMode=0700
ExecStart=/opt/bitcoinpir/cashier/bpir-cashier serve --config /etc/bitcoinpir/cashier/config.toml
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/etc/bitcoinpir/cashier

[Install]
WantedBy=multi-user.target
